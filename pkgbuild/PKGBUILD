# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=ashytv
pkgdesc="Modern GTK4/libadwaita IPTV player for your own M3U and Xtream Codes playlists"
depends=(
    'gtk4'
    'libadwaita'
    'python'
    'python-gobject'
    'python-mpv'
    'mpv'
    'librsvg'
)
optdepends=(
    'libsecret: store Xtream passwords in the system keyring'
)
makedepends=(
    'git'
    'python-build'
    'python-installer'
    'python-hatchling'
    'python-wheel'
)
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}"
    python -m build --wheel --no-isolation --skip-dependency-check
}

package() {
    cd "${srcdir}/${pkgname}"
    # No precompiled bytecode in the package (__pycache__/*.pyc).
    python -m installer --destdir="$pkgdir" --no-compile-bytecode dist/*.whl
    find "$pkgdir" -type d -name __pycache__ -prune -exec rm -rf {} +
    install -Dm755 usr/bin/ashytv "${pkgdir}/usr/bin/ashytv"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
