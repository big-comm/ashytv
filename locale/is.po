#: src/ashytv/window.py:997
msgid "Another playlist already uses this server and user."
msgstr "Annar listi notar nú þegar þennan þjón og notanda."

#: src/ashytv/window.py:1012
msgid "Another playlist already uses this address."
msgstr "Annar listi notar nú þegar þetta vistfang."

#: src/ashytv/window.py:1048 src/ashytv/window.py:1072
msgid "Updating playlist…"
msgstr "Uppfæri spilunarlista…"

#: src/ashytv/window.py:1068
msgid "Provider password not found; add the playlist again."
msgstr "Lykilorð þjónustuveitu fannst ekki; bættu spilunarlistanum við aftur."

#: src/ashytv/window.py:1102 src/ashytv/window.py:1111
#, python-brace-format
msgid "Playlist “{name}” updated."
msgstr "Spilunarlistinn „{name}“ uppfærður."

#: src/ashytv/window.py:1115
#, python-brace-format
msgid "{n} item imported."
msgid_plural "{n} items imported."
msgstr[0] "{n} atriði flutt inn."
msgstr[1] "{n} atriði flutt inn."

#: src/ashytv/window.py:1116
#, python-brace-format
msgid "Playlist ready: {n} item."
msgid_plural "Playlist ready: {n} items."
msgstr[0] "Spilunarlisti tilbúinn: {n} atriði."
msgstr[1] "Spilunarlisti tilbúinn: {n} atriði."

#: src/ashytv/window.py:1139
#, python-brace-format
msgid "Could not update “{name}”: {error}"
msgstr "Ekki tókst að uppfæra „{name}“: {error}"

#: src/ashytv/window.py:1145 src/ashytv/window.py:1148
#, python-brace-format
msgid "Failed: {error}"
msgstr "Mistókst: {error}"

#: src/ashytv/window.py:1149
#, python-brace-format
msgid "Import failed: {error}"
msgstr "Innflutningur mistókst: {error}"

#: src/ashytv/window.py:1155
msgid "Please wait for the import to finish."
msgstr "Bíddu þar til innflutningi lýkur."

#: src/ashytv/window.py:1174
msgid "Playlist removed."
msgstr "Spilunarlisti fjarlægður."

#: src/ashytv/window.py:1252
#, python-brace-format
msgid "Guide (EPG) unavailable: {error}"
msgstr "Dagskrá (EPG) ekki tiltæk: {error}"

#: src/ashytv/window.py:1316
msgid "Would you like a quick tour of AshyTV?"
msgstr "Viltu stutta kynningu á AshyTV?"

#: src/ashytv/window.py:1317
msgid ""
"A few steps over the real screens: channels, guide, movies, playlists and "
"settings. You can reopen it from the main menu."
msgstr ""
"Nokkur skref um raunverulegu skjáina: rásir, dagskrá, kvikmyndir, "
"spilunarlista og stillingar. Þú getur opnað hana aftur úr aðalvalmyndinni."

#: src/ashytv/window.py:1319
msgid "Not now"
msgstr "Ekki núna"

#: src/ashytv/window.py:1320
msgid "Start"
msgstr "Byrja"

#: src/ashytv/window.py:1368
msgid "Sections"
msgstr "Hlutar"

#: src/ashytv/window.py:1369
msgid ""
"Home, TV channels, movies, series, favorites, recordings, playlists and "
"settings. The keyboard, a remote or a game controller work too."
msgstr ""
"Heim, sjónvarpsrásir, kvikmyndir, þættir, eftirlæti, upptökur, "
"spilunarlistar og stillingar. Lyklaborð, fjarstýring eða leikjastýripinni "
"virka líka."

#: src/ashytv/window.py:1372
msgid "Channel groups"
msgstr "Rásahópar"

#: src/ashytv/window.py:1373
msgid ""
"Pick a group to see its channels. Right-click (or long-press) a group to "
"move it or hide it."
msgstr ""
"Veldu hóp til að sjá rásir hans. Hægrismelltu (eða haltu inni) á hóp til að "
"færa hann eða fela."

#: src/ashytv/window.py:1377
msgid ""
"A click selects a channel; a double-click or Enter opens it. Right-click a "
"channel to hide it or add it to your favorites."
msgstr ""
"Einn smellur velur rás; tvísmellur eða Enter opnar hana. Hægrismelltu á rás "
"til að fela hana eða bæta henni í eftirlæti."

#: src/ashytv/window.py:1381
msgid ""
"The selected channel plays here, muted (the button turns the sound on), with "
"what is on now and next."
msgstr ""
"Valin rás spilast hér án hljóðs (hnappurinn kveikir á hljóðinu), ásamt því "
"sem er á dagskrá núna og næst."

#: src/ashytv/window.py:1384
msgid "Hidden items"
msgstr "Faldir hlutir"

#: src/ashytv/window.py:1385
msgid "Everything you hid is here. Open it to show items again."
msgstr "Allt sem þú faldir er hér. Opnaðu það til að sýna hlutina aftur."

#: src/ashytv/window.py:1387
msgid "Program guide"
msgstr "Sjónvarpsdagskrá"

#: src/ashytv/window.py:1388
msgid "Switch to Guide to see what is on, hour by hour, and set reminders."
msgstr ""
"Skiptu yfir í Dagskrá til að sjá hvað er á dagskrá, klukkustund fyrir "
"klukkustund, og stilla áminningar."

#: src/ashytv/window.py:1390
msgid "Movies and series"
msgstr "Kvikmyndir og þættir"

#: src/ashytv/window.py:1391
msgid ""
"Posters with long titles scroll when you point at them. Open one to see the "
"details and the cast; click an actor to see their other titles in your "
"playlists."
msgstr ""
"Veggspjöld með löngum titlum skrunast þegar þú bendir á þau. Opnaðu eitt til "
"að sjá upplýsingar og leikara; smelltu á leikara til að sjá aðra titla hans "
"í spilunarlistunum þínum."

#: src/ashytv/window.py:1395
msgid "Favorites and recordings"
msgstr "Eftirlæti og upptökur"

#: src/ashytv/window.py:1396
msgid ""
"The heart keeps channels, movies and series here; recordings of live TV are "
"listed in Recordings."
msgstr ""
"Hjartað geymir rásir, kvikmyndir og þætti hér; upptökur af beinni útsendingu "
"eru í Upptökum."

#: src/ashytv/window.py:1400
msgid ""
"Add M3U or Xtream lists. Each list can have backup servers (other DNS of the "
"provider): the dots show if each one is online, slow or down, and AshyTV "
"switches automatically."
msgstr ""
"Bættu við M3U- eða Xtream-listum. Hver listi getur haft varaþjóna (önnur DNS "
"þjónustuveitunnar): punktarnir sýna hvort hver þeirra er tengdur, hægur eða "
"niðri, og AshyTV skiptir sjálfkrafa."

#: src/ashytv/window.py:1406
msgid ""
"Themes and colors, hidden channels and groups, secure DNS, parental PIN and "
"more."
msgstr ""
"Þemu og litir, faldar rásir og hópar, öruggt DNS, PIN foreldra og fleira."

#: src/ashytv/window.py:1409
msgid "See it again"
msgstr "Sjá aftur"

#: src/ashytv/window.py:1410
msgid ""
"Reopen this tour from the main menu (Guided tour) or from Settings → About."
msgstr ""
"Opnaðu þessa kynningu aftur úr aðalvalmyndinni (Kynningarferð) eða úr "
"Stillingar → Um forritið."

#: src/ashytv/window.py:1460
#, python-brace-format
msgid "“{name}”: the main server is not answering. Using the backup server."
msgstr "„{name}“: aðalþjónninn svarar ekki. Notar varaþjóninn."

#: src/ashytv/window.py:1463
#, python-brace-format
msgid "“{name}”: the main server is back."
msgstr "„{name}“: aðalþjónninn er kominn aftur."

#: src/ashytv/window.py:1469
msgid "AshyTV servers"
msgstr "Þjónar AshyTV"

#: src/ashytv/window.py:1491
msgid "Switching to the main server…"
msgstr "Skiptir yfir í aðalþjóninn…"

#: src/ashytv/window.py:1492
msgid "Switching to the backup server…"
msgstr "Skiptir yfir í varaþjóninn…"

#: src/ashytv/window.py:1562
msgid "Programme"
msgstr "Dagskrárliður"

#: src/ashytv/window.py:1566
#, python-brace-format
msgid "You will be reminded of “{title}” at {time}"
msgstr "Þú færð áminningu um „{title}“ kl. {time}"

#: src/ashytv/window.py:1567
msgid "Reminder cancelled"
msgstr "Hætt við áminningu"

#: src/ashytv/window.py:1579
#, python-brace-format
msgid "“{title}” starts soon on {channel}"
msgstr "„{title}“ hefst bráðum á {channel}"

#: src/ashytv/window.py:1581
msgid "AshyTV reminder"
msgstr "Áminning frá AshyTV"

#: src/ashytv/window.py:1600
msgid "This channel is no longer in your playlists."
msgstr "Þessi rás er ekki lengur í spilunarlistunum þínum."

#: src/ashytv/window.py:1640
#, python-brace-format
msgid "Group “{name}” hidden"
msgstr "Hópurinn „{name}“ var falinn"

#: src/ashytv/window.py:1641
#, python-brace-format
msgid "Category “{name}” hidden"
msgstr "Flokkurinn „{name}“ falinn"

#: src/ashytv/window.py:1655
#, python-brace-format
msgid "Channel “{name}” hidden"
msgstr "Rásin „{name}“ falin"

#: src/ashytv/window.py:1661
msgid "To show it again: Settings → Hidden channels and groups"
msgstr "Til að sýna aftur: Stillingar → Faldar rásir og hópar"

#: src/ashytv/window.py:1663
msgid "See hidden"
msgstr "Sjá falið"

#: src/ashytv/window.py:1668
msgid "Undo"
msgstr "Afturkalla"

#: src/ashytv/window.py:1974
msgid "Could not save now: a playlist is being updated. Try again."
msgstr "Ekki hægt að vista núna: verið er að uppfæra lista. Reyndu aftur."

#: data/org.communitybig.ashytv.desktop.in:3
#: data/org.communitybig.ashytv.metainfo.xml.in:4
msgid "AshyTV"
msgstr "AshyTV"

#: data/org.communitybig.ashytv.desktop.in:4
msgid "IPTV Player"
msgstr "IPTV-spilari"

#: data/org.communitybig.ashytv.desktop.in:5
msgid "Watch your own IPTV playlists (M3U and Xtream Codes)"
msgstr "Horfðu á þína eigin IPTV-spilunarlista (M3U og Xtream Codes)"

#. Translators: search keywords, separated by semicolons; keep the trailing semicolon.
#: data/org.communitybig.ashytv.desktop.in:7
msgid "iptv;tv;m3u;xtream;epg;player;live;channels;movies;series;"
msgstr "iptv;tv;m3u;xtream;epg;player;live;channels;movies;series;spilari;rásir;kvikmyndir;þættir;"

#: data/org.communitybig.ashytv.metainfo.xml.in:5
msgid "Modern IPTV player for your own playlists"
msgstr "Nútímalegur IPTV-spilari fyrir þína eigin spilunarlista"

#: data/org.communitybig.ashytv.metainfo.xml.in:9
msgid "Community Big"
msgstr "Community Big"

#: data/org.communitybig.ashytv.metainfo.xml.in:12
msgid ""
"AshyTV is a GTK4/libadwaita IPTV player. Import your own M3U playlist or "
"Xtream Codes account and browse live channels, an electronic program guide, "
"movies and series. AshyTV is only a player: it does not host or sell any "
"content."
msgstr ""
"AshyTV er IPTV-spilari gerður með GTK4/libadwaita. Fluttu inn þinn eigin M3U-"
"lagalista eða Xtream Codes-aðgang og skoðaðu beinar rásir, dagskrárvísi, "
"kvikmyndir og þáttaraðir. AshyTV er aðeins spilari: hann hýsir hvorki né "
"selur neitt efni."

#: data/org.communitybig.ashytv.metainfo.xml.in:19
msgid ""
"Optional Free TV: links to free-to-air channels and to public domain or "
"openly licensed films"
msgstr ""
"Valfrjálst ókeypis sjónvarp: tenglar á opnar rásir og kvikmyndir í "
"almenningseigu eða með opnu leyfi"

#: data/org.communitybig.ashytv.metainfo.xml.in:20
msgid "Live channels with categories, favorites and now-playing info"
msgstr ""
"Beinar rásir með flokkum, eftirlætum og upplýsingum um hvað er í gangi núna"

#: data/org.communitybig.ashytv.metainfo.xml.in:21
msgid "Program guide (XMLTV) in a time grid"
msgstr "Dagskrá (XMLTV) í tímatöflu"

#: data/org.communitybig.ashytv.metainfo.xml.in:22
msgid "Movies and series catalog with resume and next episode"
msgstr "Skrá yfir kvikmyndir og þætti með áframhaldandi áhorfi og næsta þætti"

#: data/org.communitybig.ashytv.metainfo.xml.in:23
msgid ""
"libmpv playback with hardware decoding, picture-in-picture and recording"
msgstr "Spilun með libmpv með vélbúnaðarafkóðun, mynd í mynd og upptöku"

