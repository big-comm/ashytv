#: src/ashytv/window.py:995
msgid "Connecting to the Xtream provider…"
msgstr "Připojování k poskytovateli Xtream…"

#: src/ashytv/window.py:1046
msgid "Another playlist already uses this server and user."
msgstr "Tento server a uživatele už používá jiný seznam."

#: src/ashytv/window.py:1062
msgid "Another playlist already uses this address."
msgstr "Tuto adresu už používá jiný seznam."

#: src/ashytv/window.py:1090 src/ashytv/window.py:1114
msgid "Updating playlist…"
msgstr "Aktualizace playlistu…"

#: src/ashytv/window.py:1110
msgid "Provider password not found; add the playlist again."
msgstr "Heslo poskytovatele nebylo nalezeno; přidejte playlist znovu."

#: src/ashytv/window.py:1144 src/ashytv/window.py:1153
#, python-brace-format
msgid "Playlist “{name}” updated."
msgstr "Playlist „{name}“ byl aktualizován."

#: src/ashytv/window.py:1157
#, python-brace-format
msgid "{n} item imported."
msgid_plural "{n} items imported."
msgstr[0] "Importována {n} položka."
msgstr[1] "Importovány {n} položky."
msgstr[2] "Importováno {n} položek."

#: src/ashytv/window.py:1158
#, python-brace-format
msgid "Playlist ready: {n} item."
msgid_plural "Playlist ready: {n} items."
msgstr[0] "Playlist je připraven: {n} položka."
msgstr[1] "Playlist je připraven: {n} položky."
msgstr[2] "Playlist je připraven: {n} položek."

#: src/ashytv/window.py:1181
#, python-brace-format
msgid "Could not update “{name}”: {error}"
msgstr "Playlist „{name}“ se nepodařilo aktualizovat: {error}"

#: src/ashytv/window.py:1187 src/ashytv/window.py:1190
#, python-brace-format
msgid "Failed: {error}"
msgstr "Selhalo: {error}"

#: src/ashytv/window.py:1191
#, python-brace-format
msgid "Import failed: {error}"
msgstr "Import selhal: {error}"

#: src/ashytv/window.py:1197
msgid "Please wait for the import to finish."
msgstr "Počkejte, až import skončí."

#: src/ashytv/window.py:1216
msgid "Playlist removed."
msgstr "Playlist byl odebrán."

#: src/ashytv/window.py:1294
#, python-brace-format
msgid "Guide (EPG) unavailable: {error}"
msgstr "Program (EPG) není dostupný: {error}"

#: src/ashytv/window.py:1358
msgid "Would you like a quick tour of AshyTV?"
msgstr "Chcete krátkou prohlídku AshyTV?"

#: src/ashytv/window.py:1359
msgid ""
"A few steps over the real screens: channels, guide, movies, playlists and "
"settings. You can reopen it from the main menu."
msgstr ""
"Pár kroků po skutečných obrazovkách: kanály, program, filmy, playlisty a "
"nastavení. Znovu ji otevřete z hlavní nabídky."

#: src/ashytv/window.py:1361
msgid "Not now"
msgstr "Teď ne"

#: src/ashytv/window.py:1362
msgid "Start"
msgstr "Začít"

#: src/ashytv/window.py:1410
msgid "Sections"
msgstr "Sekce"

#: src/ashytv/window.py:1411
msgid ""
"Home, TV channels, movies, series, favorites, recordings, playlists and "
"settings. The keyboard, a remote or a game controller work too."
msgstr ""
"Domů, TV kanály, filmy, seriály, oblíbené, nahrávky, playlisty a nastavení. "
"Funguje i klávesnice, dálkové ovládání nebo herní ovladač."

#: src/ashytv/window.py:1414
msgid "Channel groups"
msgstr "Skupiny kanálů"

#: src/ashytv/window.py:1415
msgid ""
"Pick a group to see its channels. Right-click (or long-press) a group to "
"move it or hide it."
msgstr ""
"Vyberte skupinu a zobrazte její kanály. Klikněte pravým tlačítkem (nebo "
"podržte) na skupinu, chcete-li ji přesunout nebo skrýt."

#: src/ashytv/window.py:1419
msgid ""
"A click selects a channel; a double-click or Enter opens it. Right-click a "
"channel to hide it or add it to your favorites."
msgstr ""
"Kliknutí vybere kanál; dvojklik nebo Enter jej otevře. Klikněte pravým "
"tlačítkem na kanál, chcete-li jej skrýt nebo přidat do oblíbených."

#: src/ashytv/window.py:1423
msgid ""
"The selected channel plays here, muted (the button turns the sound on), with "
"what is on now and next."
msgstr ""
"Vybraný kanál se zde přehrává ztlumeně (tlačítko zapne zvuk), spolu s tím, "
"co běží teď a co bude dál."

#: src/ashytv/window.py:1426
msgid "Hidden items"
msgstr "Skryté položky"

#: src/ashytv/window.py:1427
msgid "Everything you hid is here. Open it to show items again."
msgstr "Vše, co jste skryli, je zde. Otevřete to a položky znovu zobrazte."

#: src/ashytv/window.py:1429
msgid "Program guide"
msgstr "Televizní program"

#: src/ashytv/window.py:1430
msgid "Switch to Guide to see what is on, hour by hour, and set reminders."
msgstr ""
"Přepněte na Program a uvidíte, co běží hodinu po hodině, a nastavíte "
"připomínky."

#: src/ashytv/window.py:1432
msgid "Movies and series"
msgstr "Filmy a seriály"

#: src/ashytv/window.py:1433
msgid ""
"Posters with long titles scroll when you point at them. Open one to see the "
"details and the cast; click an actor to see their other titles in your "
"playlists."
msgstr ""
"Plakáty s dlouhými názvy se posouvají, když na ně najedete. Otevřete jeden a "
"uvidíte podrobnosti a obsazení; kliknutím na herce uvidíte jeho další tituly "
"ve vašich playlistech."

#: src/ashytv/window.py:1437
msgid "Favorites and recordings"
msgstr "Oblíbené a nahrávky"

#: src/ashytv/window.py:1438
msgid ""
"The heart keeps channels, movies and series here; recordings of live TV are "
"listed in Recordings."
msgstr ""
"Srdíčko sem ukládá kanály, filmy a seriály; nahrávky živého vysílání najdete "
"v Nahrávkách."

#: src/ashytv/window.py:1442
msgid ""
"Add M3U or Xtream lists. Each list can have backup servers (other DNS of the "
"provider): the dots show if each one is online, slow or down, and AshyTV "
"switches automatically."
msgstr ""
"Přidejte seznamy M3U nebo Xtream. Každý seznam může mít záložní servery "
"(jiná DNS poskytovatele): tečky ukazují, zda je každý online, pomalý nebo "
"nedostupný, a AshyTV přepíná automaticky."

#: src/ashytv/window.py:1448
msgid ""
"Themes and colors, hidden channels and groups, secure DNS, parental PIN and "
"more."
msgstr ""
"Motivy a barvy, skryté kanály a skupiny, zabezpečené DNS, rodičovský PIN a "
"další."

#: src/ashytv/window.py:1451
msgid "See it again"
msgstr "Zobrazit znovu"

#: src/ashytv/window.py:1452
msgid ""
"Reopen this tour from the main menu (Guided tour) or from Settings → About."
msgstr ""
"Tuto prohlídku znovu otevřete z hlavní nabídky (Průvodce aplikací) nebo z "
"Nastavení → O aplikaci."

#: src/ashytv/window.py:1502
#, python-brace-format
msgid "“{name}”: the main server is not answering. Using the backup server."
msgstr "„{name}“: hlavní server neodpovídá. Používá se záložní server."

#: src/ashytv/window.py:1505
#, python-brace-format
msgid "“{name}”: the main server is back."
msgstr "„{name}“: hlavní server je zpět."

#: src/ashytv/window.py:1511
msgid "AshyTV servers"
msgstr "Servery AshyTV"

#: src/ashytv/window.py:1533
msgid "Switching to the main server…"
msgstr "Přepínání na hlavní server…"

#: src/ashytv/window.py:1534
msgid "Switching to the backup server…"
msgstr "Přepínání na záložní server…"

#: src/ashytv/window.py:1604 src/ashytv/window.py:1616
msgid "Programme"
msgstr "Pořad"

#: src/ashytv/window.py:1608
#, python-brace-format
msgid "You will be reminded of “{title}” at {time}"
msgstr "Připomeneme vám „{title}“ v {time}"

#: src/ashytv/window.py:1609
msgid "Reminder cancelled"
msgstr "Připomenutí zrušeno"

#: src/ashytv/window.py:1622 src/ashytv/window.py:1644
msgid "Recording cancelled"
msgstr "Nahrávání zrušeno"

#: src/ashytv/window.py:1630
#, python-brace-format
msgid ""
"“{title}” will be recorded at {time}, at the same time as “{other}”. Your "
"provider has to allow two connections at once."
msgstr "Pořad „{title}“ se bude nahrávat v {time}, současně s pořadem „{other}“. Váš poskytovatel musí povolit dvě souběžná připojení."

#: src/ashytv/window.py:1634
#, python-brace-format
msgid "“{title}” will be recorded at {time}"
msgstr "Pořad „{title}“ se bude nahrávat v {time}"

#: src/ashytv/window.py:1644
msgid "Recording stopped."
msgstr "Nahrávání zastaveno."

#: src/ashytv/window.py:1656
msgid "The app was closed during the recording."
msgstr "Aplikace byla během nahrávání zavřena."

#: src/ashytv/window.py:1668 src/ashytv/window.py:1681
msgid "The app was not running when it started."
msgstr "Aplikace při spuštění nahrávání nebyla spuštěna."

#: src/ashytv/window.py:1696 src/ashytv/window.py:1770
msgid "This channel is no longer in your playlists."
msgstr "Tento kanál již není ve vašich playlistech."

#: src/ashytv/window.py:1709
#, python-brace-format
msgid "Recording “{title}”…"
msgstr "Nahrává se „{title}“…"

#: src/ashytv/window.py:1726
#, python-brace-format
msgid "“{title}” was recorded."
msgstr "Pořad „{title}“ byl nahrán."

#: src/ashytv/window.py:1736
#, python-brace-format
msgid "“{title}” could not be recorded."
msgstr "Pořad „{title}“ se nepodařilo nahrát."

#: src/ashytv/window.py:1749
#, python-brace-format
msgid "“{title}” starts soon on {channel}"
msgstr "„{title}“ brzy začíná na kanálu {channel}"

#: src/ashytv/window.py:1751
msgid "AshyTV reminder"
msgstr "Připomenutí AshyTV"

#: src/ashytv/window.py:1810
#, python-brace-format
msgid "Group “{name}” hidden"
msgstr "Skupina „{name}“ skryta"

#: src/ashytv/window.py:1811
#, python-brace-format
msgid "Category “{name}” hidden"
msgstr "Kategorie „{name}“ skryta"

#: src/ashytv/window.py:1825
#, python-brace-format
msgid "Channel “{name}” hidden"
msgstr "Kanál „{name}“ skryt"

#: src/ashytv/window.py:1831
msgid "To show it again: Settings → Hidden channels and groups"
msgstr "Znovu zobrazit: Nastavení → Skryté kanály a skupiny"

#: src/ashytv/window.py:1833
msgid "See hidden"
msgstr "Zobrazit skryté"

#: src/ashytv/window.py:1838
msgid "Undo"
msgstr "Vrátit zpět"

#: src/ashytv/window.py:2144
msgid "Could not save now: a playlist is being updated. Try again."
msgstr "Teď nelze uložit: aktualizuje se seznam. Zkuste to znovu."

#: data/org.communitybig.ashytv.desktop.in:3
#: data/org.communitybig.ashytv.metainfo.xml.in:4
msgid "AshyTV"
msgstr "AshyTV"

#: data/org.communitybig.ashytv.desktop.in:4
msgid "IPTV Player"
msgstr "IPTV přehrávač"

#: data/org.communitybig.ashytv.desktop.in:5
msgid "Watch your own IPTV playlists (M3U and Xtream Codes)"
msgstr "Sledujte vlastní IPTV playlisty (M3U a Xtream Codes)"

#. Translators: search keywords, separated by semicolons; keep the trailing semicolon.
#: data/org.communitybig.ashytv.desktop.in:7
msgid "iptv;tv;m3u;xtream;epg;player;live;channels;movies;series;"
msgstr "iptv;tv;m3u;xtream;epg;player;live;channels;movies;series;přehrávač;televize;živě;kanály;filmy;seriály;"

#: data/org.communitybig.ashytv.metainfo.xml.in:5
msgid "Modern IPTV player for your own playlists"
msgstr "Moderní IPTV přehrávač pro vaše vlastní playlisty"

#: data/org.communitybig.ashytv.metainfo.xml.in:9
msgid "Community Big"
msgstr "Community Big"

#: data/org.communitybig.ashytv.metainfo.xml.in:12
msgid ""
"AshyTV is a GTK4/libadwaita IPTV player. Import your own M3U playlist or "
"Xtream Codes account and browse live channels, an electronic program guide, "
"movies and series. AshyTV is only a player: it does not host or sell any "
"content."
msgstr ""
"AshyTV je IPTV přehrávač postavený na GTK4/libadwaita. Importujte vlastní "
"seznam M3U nebo účet Xtream Codes a procházejte živé kanály, programového "
"průvodce, filmy a seriály. AshyTV je jen přehrávač: nehostuje ani neprodává "
"žádný obsah."

#: data/org.communitybig.ashytv.metainfo.xml.in:19
msgid ""
"Optional Free TV: links to free-to-air channels and to public domain or "
"openly licensed films"
msgstr ""
"Volitelná TV zdarma: odkazy na volně vysílané kanály a na volná díla či "
"filmy s otevřenou licencí"

#: data/org.communitybig.ashytv.metainfo.xml.in:20
msgid "Live channels with categories, favorites and now-playing info"
msgstr "Živé kanály s kategoriemi, oblíbenými a informacemi o aktuálním pořadu"

#: data/org.communitybig.ashytv.metainfo.xml.in:21
msgid "Program guide (XMLTV) in a time grid"
msgstr "Programový průvodce (XMLTV) v časové mřížce"

#: data/org.communitybig.ashytv.metainfo.xml.in:22
msgid "Movies and series catalog with resume and next episode"
msgstr "Katalog filmů a seriálů s pokračováním a další epizodou"

#: data/org.communitybig.ashytv.metainfo.xml.in:23
msgid ""
"libmpv playback with hardware decoding, picture-in-picture and recording"
msgstr ""
"Přehrávání přes libmpv s hardwarovým dekódováním, obrazem v obraze a "
"nahráváním"

